{
  "manifest_version": 3,
  "name": "Pepper — The Personal AI Prompter",
  "short_name": "Pepper",
  "version": "0.5.1",
  "description": "A floating helper that turns rough requests into clear prompts, fixes your writing, fills job forms and keeps your files handy. Your data stays in this browser.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "unlimitedStorage", "scripting", "activeTab", "contextMenus", "alarms", "offscreen"],
  "optional_permissions": ["notifications"],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pepper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Open or close Pepper on this page"
    },
    "improve-prompt": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Improve the prompt you're typing, right in the chat box"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://claude.ai/*",
        "*://gemini.google.com/*",
        "*://www.perplexity.ai/*",
        "*://perplexity.ai/*",
        "*://copilot.microsoft.com/*",
        "*://copilot.com/*",
        "*://www.copilot.com/*"
      ],
      "js": ["lib/core.js", "lib/assist.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-ancestors 'none'"
  }
}
